DB_URL=jdbc:mysql://localhost:3306/practical_training?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8
DB_USERNAME=root
DB_PASSWORD=replace-with-your-password

# mock is for local demonstrations; http enables the future Agentic service.
AGENTIC_MODE=mock
AGENTIC_BASE_URL=http://localhost:8000
COURSE_RESOURCE_OFFICE_PREVIEW_ENABLED=false
COURSE_RESOURCE_SOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe
