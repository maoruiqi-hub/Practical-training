# Copy these values to your IDE run configuration or deployment environment.
# Do not commit a file containing real database credentials.
DB_DRIVER=org.postgresql.Driver
DB_URL=jdbc:postgresql://localhost:5432/course_platform
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-password

# Agentic AI 模式: mock(本地模拟) / deepseek(DeepSeek API) / dify(Dify平台) / http(外部agentic微服务)
AGENTIC_MODE=deepseek

# DeepSeek Anthropic-compatible API 配置（AGENTIC_MODE=deepseek 时必填）
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=sk-your-deepseek-api-key
ANTHROPIC_MODEL=deepseek-v4-pro

# Dify 平台配置（AGENTIC_MODE=dify 时必填）
# 在 Dify 中创建应用后，从「发布」页面获取 API Key
DIFY_BASE_URL=http://localhost
DIFY_CHAT_API_KEY=app-xxxxxxxxxxxxx
DIFY_COMPLETION_API_KEY=app-xxxxxxxxxxxxx
DIFY_WORKFLOW_API_KEY=app-xxxxxxxxxxxxx
DIFY_DATASET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DIFY_DATASET_API_KEY=

COURSE_RESOURCE_OFFICE_PREVIEW_ENABLED=false
COURSE_RESOURCE_SOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe
