<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neu.CoursePlatform.mapper.CourseMapper">

    <select id="selectByKeyword" resultType="com.neu.CoursePlatform.entity.Course">
        SELECT * FROM course
        WHERE course_name LIKE CONCAT('%', #{keyword}, '%')
           OR course_code LIKE CONCAT('%', #{keyword}, '%')
    </select>

</mapper>
