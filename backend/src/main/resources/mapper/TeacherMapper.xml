<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neu.CoursePlatform.mapper.TeacherMapper">

    <select id="selectByUsername" resultType="com.neu.CoursePlatform.entity.Teacher">
        SELECT * FROM teacher WHERE username = #{username}
    </select>

    <select id="selectByKeyword" resultType="com.neu.CoursePlatform.entity.Teacher">
        SELECT * FROM teacher
        WHERE name LIKE '%' || #{keyword} || '%'
           OR college LIKE '%' || #{keyword} || '%'
    </select>

</mapper>
